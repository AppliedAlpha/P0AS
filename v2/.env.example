# These are SERVER secrets for Pages Functions, never VITE_ variables.
# Generate independent random values for each environment (at least 32 characters).
SESSION_SECRET=replace_with_a_unique_random_value_of_at_least_32_characters
DATA_SECRET=replace_with_a_different_random_value_of_at_least_32_characters
TURNSTILE_SITE_KEY=your_public_site_key
TURNSTILE_SECRET_KEY=your_private_turnstile_secret
ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# Use ONE Access application covering /manage and /api/admin/*.
ACCESS_AUD=your_access_application_audience
ADMIN_EMAILS=admin@example.com
